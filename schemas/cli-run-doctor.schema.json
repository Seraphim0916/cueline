{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueline.dev/schemas/cli-run-doctor.schema.json",
  "title": "cueline run doctor --json output",
  "description": "Current serialized TypeScript shape from src/cli/observation-commands.ts; records remain free-form where declared. No CLI output changes.",
  "$ref": "#/$defs/type1",
  "$defs": {
    "type1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "const": "blocked"
            },
            {
              "const": "healthy"
            },
            {
              "const": "action_required"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "const": "blocked"
            },
            {
              "const": "cancelled"
            },
            {
              "const": "complete"
            },
            {
              "const": "starting"
            },
            {
              "const": "prompt_not_sent"
            },
            {
              "const": "controller_delivery_failed"
            },
            {
              "const": "controller_response_failed"
            },
            {
              "const": "controller_response_pending"
            },
            {
              "const": "jobs_running"
            },
            {
              "const": "controller_decision_pending"
            },
            {
              "const": "controller_archive_pending"
            },
            {
              "const": "caller_jobs_pending"
            },
            {
              "const": "caller_work_pending"
            },
            {
              "const": "caller_work_claimed"
            },
            {
              "const": "caller_work_running"
            },
            {
              "const": "runtime_active"
            },
            {
              "const": "runtime_stale"
            },
            {
              "const": "runtime_ownership_unknown"
            },
            {
              "const": "cancellation_pending"
            },
            {
              "const": "reconciliation_required"
            },
            {
              "const": "job_recovery_required"
            },
            {
              "const": "round_limit_reached"
            },
            {
              "const": "stagnation_detected"
            },
            {
              "const": "resume_ready"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "nextAction": {
          "anyOf": [
            {
              "const": "observe"
            },
            {
              "const": "recover_submitted_turn"
            },
            {
              "const": "authorize_delivery_retry"
            },
            {
              "const": "retry_delivery_timeout"
            },
            {
              "const": "authorize_controller_response_retry"
            },
            {
              "const": "retry_controller_response"
            },
            {
              "const": "retry"
            },
            {
              "const": "reconcile"
            },
            {
              "const": "inspect_jobs_then_continue"
            },
            {
              "const": "inspect_runtime"
            },
            {
              "const": "continue"
            },
            {
              "const": "execute_caller_jobs"
            },
            {
              "const": "claim_caller_work"
            },
            {
              "const": "start_caller_work"
            },
            {
              "const": "continue_caller_work"
            },
            {
              "const": "return_result"
            },
            {
              "const": "settle_controller_archive"
            },
            {
              "const": "manual_review"
            }
          ]
        },
        "eventSequence": {
          "type": "number"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type2"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "outcome",
        "phase",
        "summary",
        "nextAction",
        "eventSequence",
        "findings",
        "version"
      ]
    },
    "type2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "const": "warning"
            },
            {
              "const": "error"
            },
            {
              "const": "info"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/type3"
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "action",
        "evidence"
      ]
    },
    "type3": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "const": false
          },
          {
            "const": true
          }
        ]
      },
      "properties": {},
      "required": [],
      "description": "Free-form record; keys are not enumerated by the TypeScript contract."
    }
  }
}
