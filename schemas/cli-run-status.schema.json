{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueline.dev/schemas/cli-run-status.schema.json",
  "title": "cueline run status --json output",
  "description": "Current serialized TypeScript shape from src/cli/main.ts; records remain free-form where declared. No CLI output changes.",
  "$ref": "#/$defs/type1",
  "$defs": {
    "type1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "const": "failed"
            },
            {
              "const": "blocked"
            },
            {
              "const": "running"
            },
            {
              "const": "cancelled"
            },
            {
              "const": "complete"
            }
          ]
        },
        "executor": {
          "anyOf": [
            {
              "const": "caller"
            },
            {
              "const": "process"
            }
          ]
        },
        "allowProcessExecution": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "const": "blocked"
            },
            {
              "const": "cancelled"
            },
            {
              "const": "complete"
            },
            {
              "const": "starting"
            },
            {
              "const": "prompt_not_sent"
            },
            {
              "const": "controller_delivery_failed"
            },
            {
              "const": "controller_response_failed"
            },
            {
              "const": "controller_response_pending"
            },
            {
              "const": "jobs_running"
            },
            {
              "const": "controller_decision_pending"
            },
            {
              "const": "controller_archive_pending"
            },
            {
              "const": "caller_jobs_pending"
            },
            {
              "const": "caller_work_pending"
            },
            {
              "const": "caller_work_claimed"
            },
            {
              "const": "caller_work_running"
            },
            {
              "const": "runtime_active"
            },
            {
              "const": "runtime_stale"
            },
            {
              "const": "runtime_ownership_unknown"
            },
            {
              "const": "cancellation_pending"
            },
            {
              "const": "reconciliation_required"
            },
            {
              "const": "job_recovery_required"
            },
            {
              "const": "round_limit_reached"
            },
            {
              "const": "stagnation_detected"
            },
            {
              "const": "resume_ready"
            }
          ]
        },
        "round": {
          "type": "number"
        },
        "maxRounds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "maxStagnantRounds": {
          "type": "number"
        },
        "stagnantRounds": {
          "type": "number"
        },
        "lastProgressFingerprint": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "lastEventSequence": {
          "type": "number"
        },
        "runtime": {
          "$ref": "#/$defs/type2"
        },
        "cancellation": {
          "$ref": "#/$defs/type3"
        },
        "controller": {
          "$ref": "#/$defs/type4"
        },
        "jobs": {
          "$ref": "#/$defs/type9"
        },
        "continueAllowed": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "safeNextAction": {
          "anyOf": [
            {
              "const": "observe"
            },
            {
              "const": "recover_submitted_turn"
            },
            {
              "const": "authorize_delivery_retry"
            },
            {
              "const": "retry_delivery_timeout"
            },
            {
              "const": "authorize_controller_response_retry"
            },
            {
              "const": "retry_controller_response"
            },
            {
              "const": "retry"
            },
            {
              "const": "reconcile"
            },
            {
              "const": "inspect_jobs_then_continue"
            },
            {
              "const": "inspect_runtime"
            },
            {
              "const": "continue"
            },
            {
              "const": "execute_caller_jobs"
            },
            {
              "const": "claim_caller_work"
            },
            {
              "const": "start_caller_work"
            },
            {
              "const": "continue_caller_work"
            },
            {
              "const": "return_result"
            },
            {
              "const": "settle_controller_archive"
            },
            {
              "const": "manual_review"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "status",
        "executor",
        "allowProcessExecution",
        "phase",
        "round",
        "maxRounds",
        "maxStagnantRounds",
        "stagnantRounds",
        "lastProgressFingerprint",
        "lastEventSequence",
        "runtime",
        "cancellation",
        "controller",
        "jobs",
        "continueAllowed",
        "safeNextAction",
        "version"
      ]
    },
    "type2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "string"
        },
        "ageMs": {
          "type": "number"
        },
        "heartbeatAt": {
          "type": "string"
        },
        "ownership": {
          "anyOf": [
            {
              "const": "missing"
            },
            {
              "const": "active"
            },
            {
              "const": "stale"
            },
            {
              "const": "released"
            },
            {
              "const": "invalid"
            }
          ]
        }
      },
      "required": [
        "ownership"
      ]
    },
    "type3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runRequested": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "jobRequests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runRequested",
        "jobRequests"
      ]
    },
    "type4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archive": {
          "$ref": "#/$defs/type5"
        },
        "reconciliation": {
          "$ref": "#/$defs/type6"
        },
        "responseFailure": {
          "$ref": "#/$defs/type7"
        },
        "pendingDiagnostic": {
          "$ref": "#/$defs/type8"
        },
        "pendingTurns": {
          "type": "number"
        },
        "acceptedCommands": {
          "type": "number"
        },
        "responseAccepted": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "lastAcceptedAction": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "const": "blocked"
            },
            {
              "const": "dispatch"
            },
            {
              "const": "wait"
            },
            {
              "const": "inspect"
            },
            {
              "const": "complete"
            }
          ]
        },
        "lastAcceptedRequestId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "lastAcceptedJobKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "pendingTurns",
        "acceptedCommands",
        "responseAccepted",
        "lastAcceptedAction",
        "lastAcceptedRequestId",
        "lastAcceptedJobKeys"
      ]
    },
    "type5": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "const": "failed"
            },
            {
              "const": "pending"
            },
            {
              "const": "ambiguous"
            },
            {
              "const": "disabled"
            },
            {
              "const": "waiting_for_completion"
            },
            {
              "const": "started"
            },
            {
              "const": "archived"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "proof": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "const": "conversation_url_changed"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "status",
        "code",
        "proof"
      ]
    },
    "type6": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredReason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "operatorConfirmation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "const": "not_sent_confirmed"
            },
            {
              "const": "manual_send_confirmed"
            }
          ]
        },
        "abandonedRequestId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "retryRequestId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "promptHash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "resendBlockedReason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "requiredReason",
        "operatorConfirmation",
        "abandonedRequestId",
        "retryRequestId",
        "promptHash",
        "resendBlockedReason"
      ]
    },
    "type7": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string"
        },
        "round": {
          "type": "number"
        },
        "code": {
          "const": "CHATGPT_THINKING_FAILED"
        },
        "evidenceHash": {
          "type": "string"
        },
        "retryActionAvailable": {
          "const": false
        },
        "status": {
          "anyOf": [
            {
              "const": "observed"
            },
            {
              "const": "authorized"
            },
            {
              "const": "consumed"
            },
            {
              "const": "resent"
            },
            {
              "const": "skipped"
            },
            {
              "const": "resolved"
            }
          ]
        }
      },
      "required": [
        "requestId",
        "round",
        "code",
        "evidenceHash",
        "retryActionAvailable",
        "status"
      ]
    },
    "type8": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "CONTROLLER_OBSERVATION_PENDING_STABLE"
        },
        "failedCondition": {
          "type": "string"
        },
        "stableForMs": {
          "type": "number"
        },
        "thresholdMs": {
          "type": "number"
        },
        "observedUserMessageCount": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "baselineUserMessageCount": {
          "type": "number"
        },
        "requestMessageFound": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "requestMessageFoundBy": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "assistantTextFoundBy": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "composerPromptState": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "sourcesConsulted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "failedCondition",
        "stableForMs",
        "thresholdMs",
        "observedUserMessageCount",
        "baselineUserMessageCount",
        "requestMessageFound",
        "requestMessageFoundBy",
        "assistantTextFoundBy",
        "composerPromptState",
        "sourcesConsulted"
      ]
    },
    "type9": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "number"
        },
        "counts": {
          "$ref": "#/$defs/type10"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type11"
          }
        }
      },
      "required": [
        "total",
        "counts",
        "items"
      ]
    },
    "type10": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending": {
          "type": "number"
        },
        "running": {
          "type": "number"
        },
        "succeeded": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        },
        "timed_out": {
          "type": "number"
        },
        "cancelled": {
          "type": "number"
        },
        "ambiguous": {
          "type": "number"
        },
        "orphaned": {
          "type": "number"
        }
      },
      "required": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "ambiguous",
        "orphaned"
      ]
    },
    "type11": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution": {
          "$ref": "#/$defs/type12"
        },
        "workClaim": {
          "$ref": "#/$defs/type13"
        },
        "jobId": {
          "type": "string"
        },
        "jobKey": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "lane": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "const": "failed"
            },
            {
              "const": "pending"
            },
            {
              "const": "running"
            },
            {
              "const": "succeeded"
            },
            {
              "const": "timed_out"
            },
            {
              "const": "cancelled"
            },
            {
              "const": "ambiguous"
            },
            {
              "const": "orphaned"
            }
          ]
        },
        "persistedStatus": {
          "anyOf": [
            {
              "const": "failed"
            },
            {
              "const": "pending"
            },
            {
              "const": "running"
            },
            {
              "const": "succeeded"
            },
            {
              "const": "timed_out"
            },
            {
              "const": "cancelled"
            },
            {
              "const": "ambiguous"
            }
          ]
        }
      },
      "required": [
        "jobId",
        "jobKey",
        "required",
        "lane",
        "mode",
        "status",
        "persistedStatus"
      ]
    },
    "type12": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastProgressAt": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "pid": {
          "type": "number"
        },
        "runnerId": {
          "type": "string"
        }
      },
      "required": []
    },
    "type13": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "expiresAt": {
          "type": "string"
        },
        "heartbeatAt": {
          "type": "string"
        },
        "claimedAt": {
          "type": "string"
        },
        "claimed": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        }
      },
      "required": [
        "claimed"
      ]
    }
  }
}
