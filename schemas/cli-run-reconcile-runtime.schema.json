{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueline.dev/schemas/cli-run-reconcile-runtime.schema.json",
  "title": "cueline run reconcile-runtime --json output",
  "description": "Current serialized TypeScript shape from src/cli/main.ts; records remain free-form where declared. No CLI output changes.",
  "$ref": "#/$defs/type1",
  "$defs": {
    "type1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "const": "owner_alive"
            },
            {
              "const": "already_terminal"
            },
            {
              "const": "reconciled"
            },
            {
              "const": "processes_alive"
            }
          ]
        },
        "affectedJobs": {
          "type": "number"
        },
        "survivingJobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runId",
        "outcome",
        "affectedJobs",
        "survivingJobs"
      ]
    }
  }
}
