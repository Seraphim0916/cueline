{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueline.dev/schemas/cli-runs-sweep.schema.json",
  "title": "cueline runs sweep --json output",
  "description": "Current serialized TypeScript shape from src/cli/main.ts; records remain free-form where declared. No CLI output changes.",
  "$ref": "#/$defs/type1",
  "$defs": {
    "type1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "string"
        },
        "apply": {
          "anyOf": [
            {
              "const": false
            },
            {
              "const": true
            }
          ]
        },
        "staleMs": {
          "type": "number"
        },
        "cutoff": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type2"
          }
        },
        "sweptRuns": {
          "type": "number"
        },
        "eligibleRuns": {
          "type": "number"
        },
        "keptRuns": {
          "type": "number"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type3"
          }
        },
        "schema": {
          "const": "cueline-runs-sweep/1"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "home",
        "apply",
        "staleMs",
        "cutoff",
        "decisions",
        "sweptRuns",
        "eligibleRuns",
        "keptRuns",
        "errors",
        "schema",
        "version"
      ]
    },
    "type2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "const": "swept"
            },
            {
              "const": "eligible"
            },
            {
              "const": "kept"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "const": "runtime_active"
            },
            {
              "const": "unreadable"
            },
            {
              "const": "not_running"
            },
            {
              "const": "too_recent"
            },
            {
              "const": "unparseable_timestamp"
            },
            {
              "const": "owner_alive"
            },
            {
              "const": "workers_alive"
            },
            {
              "const": "already_terminal"
            },
            {
              "const": "sweep_failed"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "runtimeOwnership": {
          "type": "string"
        },
        "lastEventAt": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "decision"
      ]
    },
    "type3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "message"
      ]
    }
  }
}
